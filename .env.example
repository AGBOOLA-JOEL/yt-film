# yt-film settings. Copy to .env (the setup script does) and fill in what you use. Never commit .env.
# A project's own .env (made by scripts/new_project.py) wins over this one.

# Google Gemini API key (free tier works for testing): https://aistudio.google.com/apikey
# Used for: TTS narration, Lyria music, crowd murmur, dub translation, optional image generation.
GEMINI_API_KEY=

# Your channel name: written on the example ending (tools/cta.py) and kept in the dubbed end line.
YTF_CHANNEL=Your Channel

# Where new projects go (default: ~/yt-film-projects) and where finished films are copied (optional).
# YTF_WORKSPACE=~/yt-film-projects
# YTF_FINAL_DIR=~/yt-film-finished

# Voice (Gemini TTS). orus = deep calm male narrator. Others: charon, kore, aoede, fenrir, puck, leda, zephyr...
# YTF_VOICE=orus
# YTF_TTS_MODEL=gemini-3.8-flash-tts
# YTF_MUSIC_MODEL=lyria-3.5
# YTF_DUB_MODEL=gemini-3.1-pro-preview
# YTF_IMAGE_MODEL=gemini-2.5-flash-image
# YTF_CTA_MARK=like the video

# Speed (slow PCs: see references/performance.md)
# YTF_JOBS=2                     batches rendered at once (default: worked out from cores and RAM)
# YTF_X264_PRESET=faster         ultrafast/superfast/veryfast/faster/fast/medium (default medium)
# YTF_WHISPER_MODEL=small.en     word-timing model: large-v3-turbo (default), medium.en, small.en
# YTF_WHISPER=faster             force faster-whisper (default on everything except Apple Silicon)
